# Lovable Cloud / Supabase — preencha localmente, nunca commitar valores reais.
# Browser (Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server (TanStack Start)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# Stripe (assinaturas) — configure em Configurações do Projeto → Secrets
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENCIAL=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_INTELLIGENCE=
STRIPE_PRICE_FOUNDERS=
# Opcional: ID da configuração do Customer Portal com "atualizar assinatura"
# habilitado para os preços acima. Necessário para o deep link de troca de plano
# (subscription_update_confirm). Sem ele, o Portal padrão da conta é usado.
STRIPE_PORTAL_CONFIGURATION_ID=

# Modelo do Consultor IA (opcional; padrão google/gemini-3.5-flash)
LOVABLE_AI_MODEL=""

# Google Business Profile OAuth (server-only; nunca expor no Vite/browser).
# O Client ID/Secret configuram o provedor. Tokens OAuth são por estabelecimento
# e NÃO devem ser colocados aqui nem commitados no repositório.
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_REDIRECT_URI=

# Google Places API (server-only) para inteligência de mercado local.
GOOGLE_MAPS_API_KEY=

# Outras fontes externas opcionais.
META_ACCESS_TOKEN=
EVENTBRITE_API_TOKEN=
