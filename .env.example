# Lovable Cloud / Supabase — preencha localmente, nunca commitar valores reais.
# Browser (Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server (TanStack Start)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# Stripe (assinaturas) — configure em Configurações do Projeto → Secrets
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENCIAL=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_INTELLIGENCE=
STRIPE_PRICE_FOUNDERS=
# Opcional: ID da configuração do Customer Portal com "atualizar assinatura"
# habilitado para os preços acima. Necessário para o deep link de troca de plano
# (subscription_update_confirm). Sem ele, o Portal padrão da conta é usado.
STRIPE_PORTAL_CONFIGURATION_ID=

# Modelo do Consultor IA (opcional; padrão google/gemini-3.5-flash)
LOVABLE_AI_MODEL=""

# Inteligência externa (opcional; nunca commitar valores reais).
# A camada atual usa estas variáveis apenas para indicar quais fontes estão
# conectadas; ela não simula dados quando uma integração não está configurada.
GOOGLE_BUSINESS_PROFILE_ACCESS_TOKEN=
META_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=
EVENTBRITE_API_TOKEN=
